# Database configuration
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/ai_companion
# Default development fallback: sqlite+aiosqlite:///./ai_companion_dev.db
DATABASE_URL=sqlite+aiosqlite:///./ai_companion_dev.db

# Application settings
APP_ENV=development
DEBUG=True
SECRET_KEY=change-in-production-companion-secret-key-2026

# Host & Port
HOST=127.0.0.1
PORT=8000

# CORS
CORS_ORIGINS=["*"]

# LLM Provider Configuration
# Options: "gemini" (recommended / default), "groq", "mock", "openai"
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.8

# Gemini Configuration (Google AI Studio Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Groq Configuration (Fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Deployment & Cron Settings
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
CRON_SECRET=pilot-cron-secret-2026

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@ai-companion.local

