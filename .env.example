# Database configuration
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/ai_companion
# Default development fallback: sqlite+aiosqlite:///./ai_companion_dev.db
DATABASE_URL=sqlite+aiosqlite:///./ai_companion_dev.db

# Application settings
APP_ENV=development
DEBUG=True
SECRET_KEY=change-in-production-companion-secret-key-2026

# Host & Port
HOST=127.0.0.1
PORT=8000

# CORS
CORS_ORIGINS=["*"]
